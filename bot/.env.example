# CarBiz bot 環境變數。cp 成 .env 後填入,啟動時 dotenv 讀。已 gitignored。

# --- HTTP server ---
PORT=8787
DB_PATH=./carbiz.sqlite

# --- LINE ---
# Developers Console → Messaging API channel → Basic settings
LINE_CHANNEL_SECRET=
# Developers Console → Messaging API → Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=
# 白名單:只有這些 LINE userId 可下指令。逗號分隔。取得方法:
# 先留空、加 bot 為好友傳「hi」,tail bot log 找 line_user_id
ADMIN_LINE_USER_IDS=

# --- Claude worker ---
# 這台機器的私人帳號設定目錄
CLAUDE_CONFIG_DIR=/Users/carlox/.claude-personal
# claude binary 路徑。放 claude 就會用 PATH 找;
# 本機測試想用 fake-claude 就填 worker/tools/fake-claude.sh 的絕對路徑
CLAUDE_BIN=claude
# 單一 claude 子行程超過這時間會被 kill,task 標 failed
CLAUDE_TIMEOUT_MS=480000
# 同時最多幾個 claude 子行程 —— 別跟工作 worker 搶 CPU
MAX_CONCURRENT=2

# --- Sheets ---
SHEETS_SERVICE_ACCOUNT_JSON=/Users/carlox/.carbiz/service-account.json
SHEETS_FOLDER_ID=

# --- 進階 ---
# REPO_ROOT 預設是 bot/ 的父目錄(=CarBiz repo),平常不用改
# REPO_ROOT=
